# ── Market Radar AI — Variables de entorno ────────────────────────────────────
#
# TODAS las variables son opcionales. Puedes dejarlas vacías y configurarlas
# desde el dashboard web en Configuración (/settings/app).
# Los valores guardados en la BD tienen prioridad sobre los de aquí.
#
# Flujo recomendado para instalación limpia (sin .env):
#   1. docker compose up -d
#   2. Ver data/initial-password.txt para las credenciales iniciales
#   3. Acceder a http://localhost:8589 y completar el asistente de primer acceso
#   4. Ir a Configuración y rellenar las claves de API

# ── Claude AI ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
MODEL=claude-haiku-4-5-20251001

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Planificación (requieren reinicio del bot al cambiar desde la web) ────────
REPORT_HOUR=8
TIMEZONE=Europe/Madrid

# ── Dashboard web ─────────────────────────────────────────────────────────────
WEB_PORT=8589

# ── Trade Republic (opcional) ─────────────────────────────────────────────────
TR_PHONE=
TR_PIN=
TR_COOKIES_FILE=data/tr_cookies.txt
